# Copy to deploy/.env on the server and fill in. deploy/.env holds secrets: it is git-ignored and never committed.
# Generate passwords and the collab secret with: openssl rand -base64 32

# Images (GHCR, built by CI). Pin a release tag for the pilot, e.g. v0.1.0-pilot.
ATHAR_IMAGE_PREFIX=ghcr.io/abushanab-net/athar
ATHAR_TAG=latest

# Database
POSTGRES_PASSWORD=

# Hosts, all through Pangolin: the portal (the whole app; staff on the LAN can also use the server's
# address), the public agents host (OAuth issuer, /mcp) and the share host.
ATHAR_APP_URL=https://athar.example.com
ATHAR_MCP_URL=https://athar-mcp.example.com
ATHAR_SHARE_URL=https://athar-share.example.com

# Proxy ports on the server (deploy/Caddyfile). Point the Pangolin resources at <server-ip>:ATHAR_MCP_PORT and
# <server-ip>:ATHAR_SHARE_PORT. Never port-forward any of them from the internet.
ATHAR_LAN_PORT=80
ATHAR_MCP_PORT=8081
ATHAR_SHARE_PORT=8082

# Shared secret between web and collab
COLLAB_SECRET=

# Model gateway (OpenAI-compatible)
ATHAR_AI_BASE_URL=http://192.168.1.10:8080/v1
ATHAR_AI_API_KEY=
ATHAR_AI_CHAT_MODEL=Qwen3.6-35B-A3B-NVFP4
ATHAR_AI_EMBEDDING_MODEL=Qwen3-Embedding-4B

# Company SMTP relay (invitations, password resets). STARTTLS on 587 by default.
ATHAR_SMTP_HOST=
ATHAR_SMTP_PORT=587
ATHAR_SMTP_STARTTLS=true
ATHAR_SMTP_USER=
ATHAR_SMTP_PASSWORD=
ATHAR_SMTP_FROM=athar@example.com

# GitHub sources: repositories admins may connect (FR-KS-01)
ATHAR_GITHUB_ALLOWED_REPOS=your-org/*

# Loopback port for checks on the server (the proxy reaches web on the internal network)
ATHAR_WEB_PORT=8080

# Backups (NFR-08, T098): nightly to the S3-compatible bucket in KSA, 14 days. deploy/README.md "Backups".
# Encryption: generate a key pair OFF this server with `age-keygen -o athar-backup.key`, keep the key file offline
# (it's the only way to read the backups) and put its public key ("age1...") here.
BACKUP_AGE_RECIPIENT=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=athar
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_AT=02:00
BACKUP_TZ=Asia/Riyadh
BACKUP_RETENTION_DAYS=14
