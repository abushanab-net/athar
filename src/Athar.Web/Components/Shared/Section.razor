@* A titled panel inside a page (DESIGN.md Cards / Containers): flat, hairline border, 16px padding, title and actions on one row. *@
<section class="section @Class" aria-labelledby="@(Title is null ? null : id)">
    @if (Title is not null || Actions is not null)
    {
        <div class="head">
            @if (Title is not null) { <h2 id="@id" dir="auto">@Title</h2> }
            @if (Description is not null) { <p dir="auto">@Description</p> }
            @if (Actions is not null) { <div class="actions">@Actions</div> }
        </div>
    }
    <div class="body @(Flush ? "flush" : null)">@ChildContent</div>
</section>

@code {
    private readonly string id = "s" + Guid.NewGuid().ToString("N")[..8];
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    /// <summary>No inner padding: for a table or list that runs edge to edge.</summary>
    [Parameter] public bool Flush { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
