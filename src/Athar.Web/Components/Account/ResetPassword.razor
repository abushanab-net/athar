@page "/account/reset-password"
@layout AuthLayout
@attribute [ExcludeFromInteractiveRouting]
@inject AccountService Accounts
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["ResetPassword"] · Athar</PageTitle>

<AccountCard Title="@L["ChooseNewPassword"]" Error="@error" Message="@message">
    @if (Email is null || Token is null)
    {
        <p class="auth-lead">@L["ResetLinkInvalid"]</p>
        <div class="links"><a href="/account/forgot-password">@L["RequestNewLink"]</a><a href="/account/login">@L["BackToSignIn"]</a></div>
    }
    else if (message is null)
    {
        <EditForm Model="Input" FormName="reset-password" OnValidSubmit="ResetAsync" method="post">
            <div class="athar-field">
                <label for="password">@L["NewPassword"]</label>
                <InputText id="password" @bind-Value="Input.Password" type="password" autocomplete="new-password" required minlength="12" class="athar-input" dir="ltr" aria-describedby="password-help" />
            </div>
            <p class="help" id="password-help">@L["PasswordRule"]</p>
            <div class="athar-field">
                <label for="confirm">@L["ConfirmPassword"]</label>
                <InputText id="confirm" @bind-Value="Input.Confirm" type="password" autocomplete="new-password" required minlength="12" class="athar-input" dir="ltr" />
            </div>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large">@L["ResetPassword"]</MudButton>
        </EditForm>
        <div class="links"><a href="/account/forgot-password">@L["RequestNewLink"]</a></div>
    }
    else
    {
        <MudButton Href="/account/login" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large">@L["SignIn"]</MudButton>
    }
</AccountCard>

@code {
    [SupplyParameterFromQuery] private string? Email { get; set; }
    [SupplyParameterFromQuery] private string? Token { get; set; }
    [SupplyParameterFromForm] private NewPassword Input { get; set; } = default!;
    protected override void OnInitialized() => Input ??= new();
    private string? error, message;

    private async Task ResetAsync()
    {
        if (Input.Password != Input.Confirm) { error = L["PasswordsDontMatch"]; return; }
        var problems = (await Accounts.ResetPasswordAsync(Email!, Token!, Input.Password, CancellationToken.None)).ToList();
        if (problems.Count == 0) message = L["PasswordChanged"];
        else error = string.Join(" ", problems);
    }

    private sealed class NewPassword
    {
        public string Password { get; set; } = "";
        public string Confirm { get; set; } = "";
    }
}
