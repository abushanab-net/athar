@page "/account/forgot-password"
@layout AuthLayout
@attribute [ExcludeFromInteractiveRouting]
@inject AccountService Accounts
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["ForgotPassword"] · Athar</PageTitle>

<AccountCard Title="@L["ResetYourPassword"]" Lead="@(sent ? null : L["ForgotPasswordLead"])" Message="@(sent ? L["ResetLinkSent"] : null)">
    @if (!sent)
    {
        <EditForm Model="Input" FormName="forgot-password" OnValidSubmit="SendAsync" method="post">
            <div class="athar-field">
                <label for="email">@L["Email"]</label>
                <InputText id="email" @bind-Value="Input.Email" type="email" autocomplete="username" required class="athar-input" dir="ltr" />
            </div>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large">@L["SendResetLink"]</MudButton>
        </EditForm>
    }
    <div class="links"><a href="/account/login">@L["BackToSignIn"]</a></div>
</AccountCard>

@code {
    [SupplyParameterFromForm] private Request Input { get; set; } = default!;
    protected override void OnInitialized() => Input ??= new();
    private bool sent;

    private async Task SendAsync()
    {
        await Accounts.RequestPasswordResetAsync(Input.Email, CancellationToken.None);
        // The same answer whether or not the address exists.
        sent = true;
    }

    private sealed class Request
    {
        public string Email { get; set; } = "";
    }
}
