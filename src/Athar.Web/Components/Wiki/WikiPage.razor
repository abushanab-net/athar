                break;
            case PageTreeItem.TreeAction.Move:
                moving = e.Node;
                await MoveSpaceChangedAsync(e.Node.SpaceId);
                break;
            case PageTreeItem.TreeAction.CopyLink:
                await CopyAsync(Nav.ToAbsoluteUri($"/wiki/p/{e.Node.Id}").ToString());
                break;
            case PageTreeItem.TreeAction.Share:
                // Open the page with its Share panel showing.
                if (page?.Id == e.Node.Id) await OpenSideAsync(TabShare);
                else
                {
                    openShare = true;
                    Nav.NavigateTo($"/wiki/p/{e.Node.Id}");
