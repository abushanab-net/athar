        {
            Snackbar.Add(T("FileTooLarge"), Severity.Error);
            return;
        }
        uploading = true;
        try
        {
            await using var scope = Scopes.CreateAsyncScope();
            await using var content = file.OpenReadStream(AttachmentRules.MaxBytes);
            var a = await scope.ServiceProvider.GetRequiredService<AttachmentService>().UploadAsync(Session.AsActor(), page.Id, file.Name, file.ContentType, content, CancellationToken.None);
            if (AttachmentRules.Inline(a.Mime)) await editor!.RunAsync("image", a.Url);
            else await editor!.RunAsync("file", System.Text.Json.JsonSerializer.Serialize(new { href = a.Url, name = a.FileName }));
        }
        catch (AtharError e)
        {
            Snackbar.Add(e.Message, Severity.Error);
        }
        finally
        {
            uploading = false;
        }
    }

