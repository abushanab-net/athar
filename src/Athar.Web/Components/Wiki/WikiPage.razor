    /// <summary>Arrow keys, Home and End move between the side tabs (WAI-ARIA tabs pattern).</summary>
    private async Task SideTabKeyAsync(KeyboardEventArgs e, int tab)
    {
        var i = Array.FindIndex(SideTabs, t => t.Tab == tab);
        var rtl = System.Globalization.CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
        int? next = e.Key switch
        {
            "ArrowRight" => rtl ? i - 1 : i + 1,
            "ArrowLeft" => rtl ? i + 1 : i - 1,
            "Home" => 0,
            "End" => SideTabs.Length - 1,
            _ => null,
        };
        if (next is not { } n) return;
        var target = SideTabs[(n + SideTabs.Length) % SideTabs.Length].Tab;
        await TabChangedAsync(target);
        await JS.InvokeVoidAsync("athar.focus", $"side-tab-{target}");
    }

