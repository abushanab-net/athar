    private async Task OnTreeActionAsync((PageTreeItem.TreeAction Action, PageNode Node) e)
    {
        switch (e.Action)
        {
            case PageTreeItem.TreeAction.NewChild:
                await CreateAsync(e.Node.Id);
                break;
            case PageTreeItem.TreeAction.Up or PageTreeItem.TreeAction.Down:
                await Try(async pages =>
                {
                    await pages.ReorderAsync(actor!, e.Node.Id, e.Action == PageTreeItem.TreeAction.Up ? -1 : 1);
                    await LoadTreeAsync(pages);
