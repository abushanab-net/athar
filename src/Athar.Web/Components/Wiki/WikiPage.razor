                break;
            case PageTreeItem.TreeAction.Duplicate:
                await DuplicateAsync(e.Node);
                break;
            case PageTreeItem.TreeAction.CopyToSpace:
                await OpenCopyAsync(e.Node);
                break;
            case PageTreeItem.TreeAction.Import:
                OpenImport(e.Node);
                break;
            case PageTreeItem.TreeAction.Trash:
                if (await Dialogs.ShowMessageBox(T("MoveToTrash"), T("ConfirmTrash"), yesText: T("MoveToTrash"), cancelText: T("Cancel")) != true) break;
                await Try(async pages =>
                {
                    await pages.TrashAsync(actor!, e.Node.Id);
                    await LoadTreeAsync(pages);
