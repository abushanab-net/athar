    /// <summary>Pages a copy of <paramref name="node"/> would make: it and every subpage this person sees.</summary>
    private int SubtreeSize(PageNode node) => PageTree.Subtree(node.Id, tree.Select(p => (p.Id, p.ParentId))).Count();

    private async Task DuplicateAsync(PageNode node)
    {
        CopyResult? copy = null;
        await using (var scope = Scopes.CreateAsyncScope())
        {
            try
            {
                copy = await scope.ServiceProvider.GetRequiredService<PageCopyService>()
                    .DuplicateAsync(Session.AsActor(), node.Id, Guid.NewGuid().ToString(), string.Format(T("CopyOfTitle"), node.Title));
            }
            catch (AtharError e) { Snackbar.Add(e.Message, Severity.Error); }
        }
        if (copy is null) return;
        // Right after the original among its siblings, not at the end.
        await Try(async pages =>
        {
            await pages.DropAsync(actor!, copy.PageId, node.Id, DropPlace.After);
            await LoadTreeAsync(pages);
        });
        Snackbar.Add(T("Duplicated"), Severity.Success);
        Nav.NavigateTo($"/wiki/p/{copy.PageId}");
    }

    private async Task OpenCopyAsync(PageNode node)
    {
        await using var scope = Scopes.CreateAsyncScope();
        try
        {
            copyTargets = await scope.ServiceProvider.GetRequiredService<PageCopyService>().TargetsAsync(Session.AsActor(), node.Id);
            copyTo = copyTargets.FirstOrDefault(t => t.SpaceId != node.SpaceId)?.SpaceId ?? copyTargets.FirstOrDefault()?.SpaceId ?? Guid.Empty;
            copying = node;
        }
        catch (AtharError e) { Snackbar.Add(e.Message, Severity.Error); }
    }

    private async Task CopyToSpaceAsync()
    {
        var node = copying!;
        copying = null;
        await using var scope = Scopes.CreateAsyncScope();
        try
        {
            await scope.ServiceProvider.GetRequiredService<PageCopyService>().CopyToSpaceAsync(Session.AsActor(), node.Id, copyTo, null, Guid.NewGuid().ToString());
            Snackbar.Add(string.Format(T("CopiedToSpace"), copyTargets.FirstOrDefault(t => t.SpaceId == copyTo)?.Name), Severity.Success);
            if (copyTo == space!.Id) await Try(LoadTreeAsync);
        }
        catch (AtharError e) { Snackbar.Add(e.Message, Severity.Error); }
    }

    // ---------- import (T156) ----------
    private bool importing, importBusy;
    private PageNode? importUnder;
    private ImportResult? importResult;

    private void OpenImport(PageNode? under) => (importUnder, importResult, importing) = (under, null, true);

    private void CloseImport()
    {
        if (!importBusy) importing = false;
    }

    /// <summary>The background import finished while the dialog was open: show the new pages in the tree.</summary>
    private async Task ImportedAsync(ImportResult result)
    {
        importResult = result;
        if (importUnder is not null) expanded.Add(importUnder.Id);
        await Try(LoadTreeAsync);
    }

    private void OpenImported()
    {
        importing = false;
        Nav.NavigateTo($"/wiki/p/{importResult!.FirstPageId}");
    }

    private void OnPresence(IReadOnlyList<PageEditor.PresenceInfo> people) => presence = people;

    private string SaveLabel() => saveState switch
    {
        "saved" => savedRevision is { } r ? $"{T("Saved")} · r{r}" : T("Saved"),
        "synced" => T("Synced"),
        "unsynced" => T("Unsynced"),
        _ => T("Connecting"),
    };

    private string SaveIcon() => saveState switch
    {
        "saved" => Icons.Material.Outlined.CloudDone,
        "synced" => Icons.Material.Outlined.Cloud,
        "unsynced" => Icons.Material.Outlined.CloudOff,
        _ => Icons.Material.Outlined.CloudSync,
    };

    /// <summary>The presence token (WikiPage.razor.css) for a collaborator's caret color; an unknown color takes the first.</summary>
    private static int PresenceIndex(string color) => Math.Max(0, Array.IndexOf(PageEditor.Colors, color));

    private static string Initials(string name) =>
        string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpperInvariant(w[0])));

    /// <summary>Runs one use case in its own scope (and DbContext), and shows a domain error as a snackbar.</summary>
    private async Task Try(Func<PageService, Task> work)
    {
        try
        {
            await using var scope = Scopes.CreateAsyncScope();
            await work(scope.ServiceProvider.GetRequiredService<PageService>());
        }
        catch (AtharError e) when (e.Code is "not_found" && (space is null || loading))
        {
            // A page or space this person can't open (or that doesn't exist): say so inside the shell.
            denied = true;
        }
        catch (AtharError e)
        {
            Snackbar.Add(e.Message, Severity.Error);
        }
    }

