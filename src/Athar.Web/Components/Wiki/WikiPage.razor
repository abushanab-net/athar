@page "/wiki/s/{SpaceId:guid}"
@page "/wiki/p/{PageId:guid}"
@attribute [Authorize]
@using Athar.Domain.Model
@using Page = Athar.Domain.Model.Page
@using Athar.Domain.Wiki
@using Athar.Web.Services
@using System.Text.Json
@using Athar.Web.CollabBridge
@using Athar.Web.Services.Import
@inject WikiSession Session
@inject IServiceScopeFactory Scopes
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject FavoriteService Favorites
@inject WorkspaceAdminService SpaceAdmin
@inject IDialogService Dialogs
@implements IDisposable

<PageTitle>@(denied ? T("PageUnavailable") : page?.Title ?? space?.Name ?? T("Wiki")) · Athar</PageTitle>

@if (denied)
{
    <AccessDenied Title="@T("PageUnavailable")" Text="@T("PageUnavailableText")" BackHref="/wiki" BackLabel="@T("BackToWiki")" />
}
else if (actor is null || space is null)
{
    <LoadingState Rows="6" />
}
else
{
    @* Three panes (DESIGN.md Layout): tree | page | comments, versions and share. Below 960px the tree is a drawer and the
       side panel follows the page. *@
    <div class="wiki-root athar-full-bleed @(page is null || !sideOpen ? "no-side" : null) @(treeOpen ? "tree-open" : null)">
        <nav class="wiki-tree" id="wiki-tree" aria-labelledby="wiki-tree-title" @onkeydown="TreeKey" @ref="treeRef">
            <div class="tree-head">
                <SpaceBadge Name="@space.Name" Id="space.Id" Color="@space.Color" Icon="@space.Icon" />
                <h2 id="wiki-tree-title" class="athar-truncate" title="@space.Name" dir="auto">@space.Name</h2>
                @* Pin the space to the side menu. *@
                <IconAction Icon="@(favorite ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)" Label="@T("Favorite")"
                            Color="@(favorite ? Color.Warning : Color.Default)" aria-pressed="@(favorite ? "true" : "false")" OnClick="ToggleFavoriteAsync" />
                <span class="tree-close">
                    <IconAction Icon="@Icons.Material.Filled.Close" Label="@T("ClosePages")" OnClick="() => treeOpen = false" />
                </span>
            </div>

            @* T116: quick links for the space. *@
            <ul class="quick-links">
                <li><a href="@($"/wiki/s/{space.Id}")" class="quick-link"><MudIcon Icon="@Icons.Material.Outlined.Home" Size="Size.Small" aria-hidden="true" />@T("Overview")</a></li>
                <li><a href="/search" class="quick-link"><MudIcon Icon="@Icons.Material.Outlined.Search" Size="Size.Small" aria-hidden="true" />@T("SearchLink")</a></li>
                @if (canManageSpace)
                {
                    @* T114: the space's settings (name, badge, AI policy, members, classification) without leaving the wiki. *@
                    <li><button type="button" class="quick-link" @onclick="OpenSpaceSettingsAsync"><MudIcon Icon="@Icons.Material.Outlined.Settings" Size="Size.Small" aria-hidden="true" />@T("SpaceSettings")</button></li>
                }
                @if (canEditSpace)
                {
                    <li><button type="button" class="quick-link" @onclick="() => CreateAsync(null)"><MudIcon Icon="@Icons.Material.Outlined.NoteAdd" Size="Size.Small" aria-hidden="true" />@T("NewPage")</button></li>
                }
            </ul>

            <div class="pages-head">
                <span class="pages-label">@T("Pages")</span>
                @if (canEditSpace)
                {
                    <IconAction Icon="@Icons.Material.Filled.Add" Label="@T("AddPage")" OnClick="() => CreateAsync(null)" />
                }
                <MenuButton Icon="@Icons.Material.Filled.MoreHoriz" Label="@T("PagesMenu")">
                    <MudMenuItem Icon="@Icons.Material.Outlined.UnfoldLess" OnClick="CollapseAll">@T("CollapseAll")</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Outlined.Delete" OnClick="ToggleTrashAsync">@T(showTrash ? "HideTrash" : "ShowTrash")</MudMenuItem>
                    @if (canManageSpace)
                    {
                        <MudMenuItem Icon="@Icons.Material.Outlined.FileUpload" OnClick="() => OpenImport(null)">@T("ImportPages")</MudMenuItem>
                    }
                    @* T157: a download (target _blank so the Blazor router doesn't take the link). *@
                    <MudMenuItem Icon="@Icons.Material.Outlined.FileDownload" Href="@($"/wiki/export?space={space.Id}")" Target="_blank">@T("ExportSpace")</MudMenuItem>
                </MenuButton>
            </div>

            @if (showTrash)
            {
                <p class="tree-label">@T("Trash")</p>
                @if (trash.Count == 0)
                {
                    <EmptyState Icon="@Icons.Material.Outlined.Delete" Title="@T("TrashEmpty")" Compact="true" />
                }
                <ul class="trash-list">
                    @foreach (var p in trash.Where(p => p.ParentId is null || !trash.Any(t => t.Id == p.ParentId)))
                    {
                        <li class="trash-row" @key="p.Id">
                            <div class="trash-text">
                                <span class="athar-truncate" title="@p.Title" dir="auto">@p.Title</span>
                                <span class="trash-until">@T("RestoreUntil") <Timestamp Value="@(p.DeletedAt!.Value + PageTree.TrashRetention)" DateOnly="true" /></span>
                            </div>
                            @if (canEditSpace)
                            {
                                <IconAction Icon="@Icons.Material.Outlined.RestoreFromTrash" Label="@($"{T("Restore")}: {p.Title}")" OnClick="() => RestoreAsync(p.Id)" />
                            }
                        </li>
                    }
                </ul>
            }
            else if (tree.Count == 0)
            {
                <EmptyState Icon="@Icons.Material.Outlined.Article" Title="@T("EmptySpace")" Compact="true" />
            }
            else
            {
                <ul class="page-tree">
                    @foreach (var root in children[null].Take(rootsShown))
                    {
                        <PageTreeItem @key="root.Id" Node="root" Children="children" SelectedId="page?.Id" CanEdit="canEditSpace" CanImport="canManageSpace" OnAction="OnTreeActionAsync"
                                      Expanded="expanded" OnToggle="ToggleNode" Stamp="treeStamp" />
                    }
                    @if (children[null].Count() > rootsShown)
                    {
                        <li><button type="button" class="tree-more" @onclick="() => { rootsShown += PageTreeItem.Step; treeStamp++; }">@string.Format(T("ShowMorePages"), children[null].Count() - rootsShown)</button></li>
                    }
                </ul>
            }
        </nav>
        @if (treeOpen)
        {
            <div class="tree-scrim" @onclick="() => treeOpen = false"></div>
        }

        <div class="wiki-page @(fullWidth ? null : "narrow")">
            @if (page is null)
            {
                <span class="tree-toggle">
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.AccountTree" OnClick="() => treeOpen = true"
                               aria-controls="wiki-tree" aria-expanded="@(treeOpen ? "true" : "false")">@T("Pages")</MudButton>
                </span>
                <EmptyState Icon="@Icons.Material.Outlined.Article" Title="@T("PickAPage")">
                    @if (canEditSpace)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.NoteAdd" OnClick="() => CreateAsync(null)">@T("NewPage")</MudButton>
                    }
                </EmptyState>
            }
            else
            {
                @* T115 (U-2): print hides the app chrome and the page's controls; only the title, byline and content print. *@
                <HeadContent><style media="print">.athar-drawer,.athar-topbar,.wiki-tree,.wiki-side,.tree-toggle,.page-bar,.editor-toolbar{display:none!important}</style></HeadContent>
                @* T152: a first-visit tour of the page's tools; the top bar's help button replays it. *@
                <PageTour Id="wiki-page" Help="wiki" Steps="@WikiTour" />
                @* The page bar (Docmost-style): the breadcrumb on the start side, the page's actions on the end side. *@
                <div class="page-bar">
                    <span class="bar-tree-toggle">
                        @* Narrow screens: the tree is a drawer; the button says what it opens (DESIGN.md: a "Pages" button). *@
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.AccountTree" OnClick="() => treeOpen = true"
                                   aria-controls="wiki-tree" aria-expanded="@(treeOpen ? "true" : "false")">@T("Pages")</MudButton>
                    </span>
                    <nav class="crumbs" aria-label="@T("Breadcrumb")">
                        <ol>
                            <li><a href="@($"/wiki/s/{space.Id}")" title="@space.Name" dir="auto">@space.Name</a></li>
                            @{ var path = Ancestors(); }
                            @if (path.Count > 1)
                            {
                                @* Only the parent shows; the rest of the path folds into a menu. *@
                                <li>
                                    <MudMenu Size="Size.Small" Dense="true" AriaLabel="@T("ShowPath")" Class="crumb-more">
                                        <ActivatorContent><span class="crumb-fold" title="@T("ShowPath")">…</span></ActivatorContent>
                                        <ChildContent>
                                            @foreach (var a in path.SkipLast(1))
                                            {
                                                <MudMenuItem Href="@($"/wiki/p/{a.Id}")"><bdi>@a.Title</bdi></MudMenuItem>
                                            }
                                        </ChildContent>
                                    </MudMenu>
                                </li>
                            }
                            @if (path.Count > 0)
                            {
                                <li><a href="@($"/wiki/p/{path[^1].Id}")" title="@(path[^1].Title)" dir="auto">@(path[^1].Title)</a></li>
                            }
                            <li aria-current="page"><span title="@(page.Title)" dir="auto">@(page.Title)</span></li>
                        </ol>
                    </nav>
                    <div class="page-actions">
                        @if (page.Status == PageStatus.Draft)
                        {
                            <Seal Kind="Seal.Kinds.Warn" Icon="@Icons.Material.Outlined.EditNote">@T("Draft")</Seal>
                            @if (canEditPage)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="PublishAsync">@T("Publish")</MudButton>
                            }
                        }
                        @if (canEditPage)
                        {
                            <div class="mode" role="group" aria-label="@T("PageMode")">
                                <button type="button" aria-pressed="@(readMode ? "false" : "true")" @onclick="() => SetModeAsync(false)">@T("Edit")</button>
                                <button type="button" aria-pressed="@(readMode ? "true" : "false")" @onclick="() => SetModeAsync(true)">@T("Read")</button>
                            </div>
                            <button type="button" class="share-button" aria-pressed="@Pressed(TabShare)" @onclick="() => ToggleSideAsync(TabShare)">@T("Share")</button>
                        }
                        else
                        {
                            <Seal Kind="Seal.Kinds.Quiet" Icon="@Icons.Material.Outlined.Visibility">@T("ReadOnly")</Seal>
                        }
                        <IconAction Icon="@Icons.Material.Outlined.Toc" Label="@T("Outline")" aria-pressed="@Pressed(TabOutline)" OnClick="() => ToggleSideAsync(TabOutline)" />
                        <span class="with-count">
                            <IconAction Icon="@Icons.Material.Outlined.ChatBubbleOutline" Label="@T("CommentsPanel")" aria-pressed="@Pressed(TabComments)" OnClick="() => ToggleSideAsync(TabComments)" />
                            @if (openThreads > 0)
                            {
                                <span class="count" aria-hidden="true" @key="openThreads">@openThreads</span>
                            }
                        </span>
                        <MenuButton Icon="@Icons.Material.Filled.MoreHoriz" Label="@T("MorePageActions")" OpenChanged="MenuOpenChangedAsync" Class="page-menu">
                            <MudMenuItem Icon="@Icons.Material.Outlined.Link" OnClick="CopyLinkAsync">@T("CopyLink")</MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Outlined.ContentCopy" OnClick="CopyMarkdownAsync">@T("CopyMarkdown")</MudMenuItem>
                            @* T118 (U-3): watch for updates, comments and the trash. *@
                            <MudMenuItem Icon="@(watching ? Icons.Material.Filled.NotificationsActive : Icons.Material.Outlined.NotificationsNone)" OnClick="ToggleWatchAsync">@T(watching ? "Unwatch" : "Watch")</MudMenuItem>
                            <MudMenuItem Icon="@(fullWidth ? Icons.Material.Outlined.CheckBox : Icons.Material.Outlined.CheckBoxOutlineBlank)" OnClick="ToggleWidthAsync">@T("FullWidth")</MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Outlined.History" OnClick="() => OpenSideAsync(TabVersions)">@T("PageHistory")</MudMenuItem>
                            @if (canEditPage)
                            {
                                <MudMenuItem Icon="@Icons.Material.Outlined.DriveFileMove" OnClick="() => PageActionAsync(PageTreeItem.TreeAction.Move)">@T("MoveTo")</MudMenuItem>
                            }
                            <MudMenuItem Icon="@Icons.Material.Outlined.Print" OnClick="PrintAsync">@T("PrintPdf")</MudMenuItem>
                            @* T157 (FR-PG-10) *@
                            <MudMenuItem Icon="@Icons.Material.Outlined.FileDownload" Href="@($"/wiki/export?page={page.Id}&format=md")" Target="_blank">@T("ExportMarkdown")</MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Outlined.FileDownload" Href="@($"/wiki/export?page={page.Id}&format=html")" Target="_blank">@T("ExportHtml")</MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Outlined.FolderZip" Href="@($"/wiki/export?page={page.Id}&format=zip")" Target="_blank">@T("ExportZip")</MudMenuItem>
                            @if (canEditPage && page.Status == PageStatus.Published)
                            {
                                <MudMenuItem Icon="@Icons.Material.Outlined.EditNote" OnClick="UnpublishAsync">@T("Unpublish")</MudMenuItem>
                            }
                            @if (canEditPage)
                            {
                                <MudMenuItem Icon="@Icons.Material.Outlined.Delete" IconColor="Color.Error" OnClick="TrashPageAsync">@T("MoveToTrash")</MudMenuItem>
                            }
                            <MudDivider />
                            <div class="page-facts">
                                @if (wordCount is { } words)
                                {
                                    <span>@string.Format(T("WordCount"), words)</span>
                                }
                                @if (page.CreatedBy is { } maker && names.TryGetValue(maker, out var makerName))
                                {
                                    <span>@T("CreatedBy") <bdi>@makerName</bdi></span>
                                }
                                <span>@T("CreatedAt") <Timestamp Value="page.CreatedAt" /></span>
                            </div>
                        </MenuButton>
                    </div>
                </div>
                <header class="page-head">
                    @if (Editing)
                    {
                        @* The title is the page's h1, editable in place: it looks like a field only on hover and focus (Enter or leaving saves). *@
                        <h1 class="page-title"><input class="title-input" @bind="title" @bind:event="oninput" @onblur="RenameAsync" @onkeydown="TitleKeyAsync"
                                                      aria-label="@T("Title")" dir="auto" autocomplete="off" /></h1>
                    }
                    else
                    {
                        <h1 class="page-title" dir="auto">@(page.Title)</h1>
                    }
                    <p class="byline">
                        @if (authorId is { } author && names.TryGetValue(author, out var authorName))
                        {
                            <span class="author-chip">
                                <Avatar UserId="author" Name="@authorName" Size="small" />
                                <span>@T("By") <bdi class="author">@authorName</bdi></span>
                            </span>
                        }
                        <span>@T("UpdatedAt") <Timestamp Value="page.UpdatedAt" Relative="true" /></span>
                        <span class="spacer"></span>
                        @if (presence.Count > 0)
                        {
                            <ul class="presence" aria-label="@T("Editors")">
                                @foreach (var p in presence.Take(5))
                                {
                                    var who = p.Self ? $"{p.Name} ({T("You")})" : p.Name;
                                    <li class="avatar presence-@PresenceIndex(p.Color)" title="@who"><span aria-hidden="true">@Initials(p.Name)</span><span class="visually-hidden">@who</span></li>
                                }
                                @if (presence.Count > 5)
                                {
                                    <li class="avatar more" title="@string.Join(", ", presence.Skip(5).Select(p => p.Name))">+@(presence.Count - 5)</li>
                                }
                            </ul>
                        }
                        <span class="save-state" role="status">
                            <Seal Kind="@(saveState == "unsynced" ? Seal.Kinds.Warn : Seal.Kinds.Quiet)" Icon="@SaveIcon()"
                                  Tooltip="@(saveState == "saved" && savedRevision is { } r ? string.Format(T("RevisionN"), r) : null)">@SaveLabel()</Seal>
                        </span>
                    </p>
                </header>

                @if (Editing)
                {
                    <div class="editor-toolbar" role="toolbar" aria-label="@T("Formatting")">
                        @for (var g = 0; g < Tools.Length; g++)
                        {
                            if (g > 0)
                            {
                                <span class="sep" aria-hidden="true"></span>
                            }
                            foreach (var (cmd, icon, label, arg) in Tools[g])
                            {
                                if (Menus.TryGetValue(cmd, out var items))
                                {
                                    @* A small menu where a row of buttons would crowd the bar: text styles, table rows and columns. *@
                                    <MenuButton Icon="@icon" Label="@T(label)" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
                                        @foreach (var (itemCmd, itemLabel, itemArg) in items)
                                        {
                                            <MudMenuItem OnClick="() => ToolAsync(itemCmd, itemArg)">@T(itemLabel)</MudMenuItem>
                                        }
                                    </MenuButton>
                                }
                                else
                                {
                                    <IconAction Icon="@icon" Label="@T(label)" OnClick="() => ToolAsync(cmd, arg)" />
                                }
                            }
                        }
                        @* FR-PG-02/06: an image goes in inline, any other file as a link to it. *@
                        <MudFileUpload T="IBrowserFile" FilesChanged="UploadAsync" Accept=".png,.jpg,.jpeg,.gif,.webp,.pdf,.docx" Disabled="uploading">
                            <ActivatorContent>
                                <IconAction Icon="@Icons.Material.Filled.AttachFile" Label="@T("AttachFile")" Disabled="uploading" />
                            </ActivatorContent>
                        </MudFileUpload>
                    </div>
                }

                <PageEditor @key="page.Id" @ref="editor" PageId="page.Id" Actor="actor" Name="@Session.Name" Level="@level"
                            Label="@T("PageContent")" OnSaveState="OnSaveState" OnPresence="OnPresence"
                            SlashItems="@(canEditPage ? SlashItems() : [])" OnTool="cmd => ToolAsync(cmd, null)" />
            }
        </div>

        @if (page is not null)
        {
            @* Outline (default), Comments, Versions. Share opens from the page bar as its own panel. The comments panel stays
               mounted while hidden: it keeps the open count and the editor's resolved highlights current. *@
            <aside class="wiki-side" aria-label="@T("PagePanels")" hidden="@(!sideOpen)" @key="page.Id">
                @if (sideTab == TabShare && canEditPage)
                {
                    <div class="side-head">
                        <h2>@T("Share")</h2>
                        <IconAction Icon="@Icons.Material.Outlined.Close" Label="@T("Close")" OnClick="() => ToggleSideAsync(TabShare)" />
                    </div>
                    <SharePanel PageId="page.Id" SpaceId="page.SpaceId" CanManageSpace="canModerate" />
                }
                else
                {
                    <div class="side-tabs" role="tablist" aria-label="@T("PagePanels")">
                        @foreach (var (tab, label) in SideTabs)
                        {
                            <button type="button" role="tab" id="side-tab-@tab" aria-selected="@(sideTab == tab ? "true" : "false")" aria-controls="side-panel-@tab"
                                    tabindex="@(sideTab == tab ? 0 : -1)" @onclick="() => TabChangedAsync(tab)" @onkeydown="e => SideTabKeyAsync(e, tab)">
                                @T(label)
                                @if (tab == TabComments && openThreads > 0)
                                {
                                    <span class="tab-count">@openThreads</span>
                                }
                            </button>
                        }
                    </div>
                }
                <div class="side-panel" role="tabpanel" id="side-panel-@TabOutline" aria-labelledby="side-tab-@TabOutline" hidden="@(sideTab != TabOutline)">
                    <nav class="outline" aria-label="@T("Outline")">
                        @if (outline.Length == 0)
                        {
                            <EmptyState Icon="@Icons.Material.Outlined.Toc" Title="@T("NoHeadings")" Compact="true" />
                        }
                        @foreach (var h in outline)
                        {
                            <button type="button" class="outline-item level-@h.Level" dir="auto" @onclick="() => editor!.ScrollToHeadingAsync(h.Pos)">@h.Text</button>
                        }
                    </nav>
                </div>
                <div class="side-panel side-comments" role="tabpanel" id="side-panel-@TabComments" aria-labelledby="side-tab-@TabComments" hidden="@(sideTab != TabComments)">
                    <CommentsPanel PageId="page.Id" CanComment="canComment" CanModerate="canModerate" OnCount="n => openThreads = n"
                                   GetSelection="GetCommentSelection" Focus="id => editor!.FocusThreadAsync(id)"
                                   ClearSelection="ClearCommentSelection" OnResolved="SetResolvedThreads" />
                </div>
                @if (sideTab == TabVersions)
                {
                    <div class="side-panel" role="tabpanel" id="side-panel-@TabVersions" aria-labelledby="side-tab-@TabVersions">
                        <VersionsPanel PageId="page.Id" CanEdit="canEditPage" />
                    </div>
                }
            </aside>
        }
    </div>

    @if (canEditPage)
    {
        <MudDialog Visible="urlFor is not null" VisibleChanged="v => { if (!v) urlFor = null; }" Options="SmallDialog">
            <TitleContent>@(urlFor == "image" ? T("InsertImage") : T("InsertLink"))</TitleContent>
            <DialogContent>
                <MudTextField T="string" @bind-Value="url" Label="@T("Url")" InputType="InputType.Url" AutoFocus="true" Immediate="true"
                              OnKeyDown="UrlKeyAsync" dir="ltr" />
            </DialogContent>
            <DialogActions>
                <MudButton OnClick="() => urlFor = null">@T("Cancel")</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="InsertUrlAsync">@T("Insert")</MudButton>
            </DialogActions>
        </MudDialog>
    }
    @if (canEditSpace)
    {
        @* T156 (FR-PG-09): import Markdown, HTML, a zip of them or a Confluence HTML export, here or under a page. *@
        <MudDialog Visible="importing" VisibleChanged="v => { if (!v) CloseImport(); }" Options="SmallDialog">
            <TitleContent>@T("ImportPages")</TitleContent>
            <DialogContent>
                <p class="move-what" dir="auto">@(importUnder?.Title ?? space?.Name)</p>
                <p class="import-help">@T("ImportHelp")</p>
                @if (space is not null)
                {
                    @* T164: uploaded over HTTP, imported in the background (up to 4 GB). *@
                    <ImportUpload Mode="space" TargetId="space.Id" ParentId="importUnder?.Id" BusyChanged="b => importBusy = b" OnDone="ImportedAsync" />
                }
            </DialogContent>
            <DialogActions>
                <MudButton OnClick="CloseImport" Disabled="importBusy">@T(importResult is null ? "Cancel" : "Close")</MudButton>
                @if (importResult is not null)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenImported">@T("OpenImported")</MudButton>
                }
            </DialogActions>
        </MudDialog>

        <MudDialog Visible="copying is not null" VisibleChanged="v => { if (!v) copying = null; }" Options="SmallDialog">
            <TitleContent>@T("CopyToSpace")</TitleContent>
            <DialogContent>
                @if (copying is not null)
                {
                    <p class="move-what" dir="auto">@copying.Title</p>
                    @if (copyTargets.Count == 0)
                    {
                        <p>@T("NoCopyTargets")</p>
                    }
                    else
                    {
                        <MudSelect T="Guid" @bind-Value="copyTo" Label="@T("TargetSpace")" Class="mb-3">
                            @foreach (var t in copyTargets)
                            {
                                <MudSelectItem Value="t.SpaceId"><bdi>@t.Name</bdi></MudSelectItem>
                            }
                        </MudSelect>
                        <p class="copy-count">@string.Format(T("CopyPagesCount"), SubtreeSize(copying))</p>
                    }
                }
            </DialogContent>
            <DialogActions>
                <MudButton OnClick="() => copying = null">@T("Cancel")</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="copyTargets.Count == 0 || (copying is not null && SubtreeSize(copying) > PageCopyService.MaxPages)"
                           OnClick="CopyToSpaceAsync">@T("Copy")</MudButton>
            </DialogActions>
        </MudDialog>

        <MudDialog Visible="moving is not null" VisibleChanged="v => { if (!v) moving = null; }" Options="SmallDialog">
            <TitleContent>@T("MovePage")</TitleContent>
            <DialogContent>
                @if (moving is not null)
                {
                    <p class="move-what" dir="auto">@moving.Title</p>
                    <MudSelect T="Guid" Value="moveSpace" ValueChanged="MoveSpaceChangedAsync" Label="@T("TargetSpace")" Class="mb-3">
                        @foreach (var s in moveSpaces)
                        {
                            <MudSelectItem Value="s.Id"><bdi>@s.Name</bdi></MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="Guid" @bind-Value="moveParent" Label="@T("TargetParent")">
                        <MudSelectItem Value="Guid.Empty">@T("TopLevel")</MudSelectItem>
                        @foreach (var p in moveParents)
                        {
                            <MudSelectItem Value="p.Id"><bdi>@p.Title</bdi></MudSelectItem>
                        }
                    </MudSelect>
                }
            </DialogContent>
            <DialogActions>
